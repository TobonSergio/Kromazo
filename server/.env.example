# Copia este archivo como server/.env y ajusta los valores.

# development | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Archivo de la base de datos SQLite (se crea solo).
DATABASE_PATH=./data/negocio.db

# Carpeta de fotos subidas por clientes y por el local (fuera de la carpeta pública). Respáldala junto con la BD.
UPLOADS_PATH=./data/uploads

# Sesiones: expiran tras X horas sin uso y, como máximo, a los N días.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# true cuando se sirva por HTTPS (dominio en internet). En la red local por HTTP: false.
# Si no se define, es true en producción.
COOKIE_SECURE=false

# true solo si hay un proxy delante (Caddy/Nginx) que envía X-Forwarded-For.
TRUST_PROXY=false

# Bloqueo de cuenta tras N intentos fallidos, durante M minutos.
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Máximo de peticiones por minuto y por IP a /api/auth/*.
AUTH_RATE_LIMIT_PER_MIN=10

# Carpeta del frontend compilado (npm run build). Vacío = no servirlo.
WEB_DIST_PATH=../web/dist

# Respaldos (npm run backup): carpeta y cantidad de copias de la BD a conservar.
# OJO: en el servidor, copia esta carpeta FUERA de la máquina (docs/DESPLIEGUE.md).
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
