      "checkConstraints": {
        "cuts_method_check": {
          "name": "cuts_method_check",
          "value": "\"cuts\".\"method\" IN ('MEASURED','FREEHAND')"
        },
        "cuts_length_check": {
          "name": "cuts_length_check",
          "value": "\"cuts\".\"cut_length_mm\" IS NULL OR \"cuts\".\"cut_length_mm\" > 0"
        },
        "cuts_width_check": {
          "name": "cuts_width_check",
          "value": "\"cuts\".\"cut_width_mm\" IS NULL OR \"cuts\".\"cut_width_mm\" > 0"
        },
        "cuts_area_check": {
          "name": "cuts_area_check",
          "value": "\"cuts\".\"cut_area_mm2\" > 0"
        },
        "cuts_used_check": {
          "name": "cuts_used_check",
          "value": "\"cuts\".\"used_area_mm2\" >= 0"
        },
        "cuts_remnant_check": {
          "name": "cuts_remnant_check",
          "value": "\"cuts\".\"remnant_area_mm2\" >= 0"
        },
        "cuts_waste_check": {
          "name": "cuts_waste_check",
          "value": "\"cuts\".\"waste_area_mm2\" >= 0"
        },
        "cuts_measured_check": {
          "name": "cuts_measured_check",
          "value": "\"cuts\".\"method\" = 'FREEHAND' OR (\"cuts\".\"cut_length_mm\" IS NOT NULL AND \"cuts\".\"cut_width_mm\" IS NOT NULL AND \"cuts\".\"cut_area_mm2\" = \"cuts\".\"cut_length_mm\" * \"cuts\".\"cut_width_mm\")"
        },
        "cuts_freehand_waste_check": {
          "name": "cuts_freehand_waste_check",
          "value": "\"cuts\".\"method\" = 'MEASURED' OR \"cuts\".\"waste_area_mm2\" = 0"
        },
        "cuts_measured_no_freehand_check": {
          "name": "cuts_measured_no_freehand_check",
          "value": "\"cuts\".\"method\" = 'FREEHAND' OR (\"cuts\".\"freehand_size_id\" IS NULL AND \"cuts\".\"reconciled_count_id\" IS NULL)"
        },
        "cuts_conservation_check": {
          "name": "cuts_conservation_check",
          "value": "\"cuts\".\"used_area_mm2\" + \"cuts\".\"remnant_area_mm2\" + \"cuts\".\"waste_area_mm2\" = \"cuts\".\"cut_area_mm2\""
        }
      }
